# LINE 字型诊断 v3：完整 ZIP 只捕获响应头，清单候选捕获正文
# 完全透传；secure ZIP 不经过 response-body 缓冲。

[rewrite_local]
^https?:\/\/talk-asset\.line-scdn\.net\/secure\/.*\.zip(?:\?.*)?$ url script-response-header https://raw.githubusercontent.com/w902287/line-custom-font/abd5431/line-font-secure-header-capture-v3.js
^https?:\/\/(?!talk-asset\.line-scdn\.net\/secure\/)[^\/]*(?:line\.me|line-apps\.com|line-scdn\.net|line\.naver\.jp)\/.* url script-response-body https://raw.githubusercontent.com/w902287/line-custom-font/90b7f2f/line-font-manifest-capture-v2.js

[mitm]
hostname = *.line.me, *.line-apps.com, *.line-scdn.net, *.line.naver.jp, talk-asset.line-scdn.net
