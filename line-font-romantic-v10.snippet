^https?:\/\/talk-asset\.line-scdn\.net(?::443)?\/secure\/119ae2b9-ed0e-49ed-8b9b-a013918b81b7\/TT07-armochih32c90b5_md_scale\.zip(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/w902287/line-custom-font/054c91d/line-font-romantic-v10-zip.js

