#!name = LINE 自定義字型替換 (浪漫雅圓)
#!desc = 攔截 LINE 官方字型下載並注入自定義浪漫雅圓 (含通知與日誌)
#!openUrl = https://github.com/w902287/line-custom-font
#!author = w902287

[mitm]
hostname = talk-asset.line-scdn.net, *.line-scdn.net

[rewrite_remote]
^https?:\/\/talk-asset\.line-scdn\.net\/secure\/[^\/]+\/.*\.zip url script-response-body https://raw.githubusercontent.com/w902287/line-custom-font/main/line-font-sync.js, requires-body=1, binary-body-mode=1
